APP_NAME="Salla Store Cloner"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://yourdomain.com

# قاعدة البيانات
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=salla_cloner
DB_USERNAME=root
DB_PASSWORD=

# Cache — مطلوب للـ atomic lock في TokenManager
# استخدم redis في الإنتاج (لمنع race conditions عبر عدة processes)
CACHE_DRIVER=redis
# CACHE_DRIVER=file  # مقبول فقط في التطوير المحلي

# Queue — استخدم redis أو database في الإنتاج
QUEUE_CONNECTION=redis
# QUEUE_CONNECTION=database  # خيار آمن بدون Redis

# Redis (مطلوب للـ Cache + Queue في الإنتاج)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ===================================================
# إعدادات تطبيق سلة — من بوابة الشركاء
# ===================================================
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
# سر التحقق من توقيع الـ Webhook (Signature strategy)
SALLA_WEBHOOK_SECRET=

# ===================================================
# إعدادات المزامنة (اختيارية — القيم الافتراضية مناسبة)
# ===================================================
SALLA_SYNC_PER_PAGE=50
SALLA_RETRY_BASE_SECS=2
SALLA_MAX_RETRIES=5
SALLA_SYNC_QUEUE=salla-sync

# ===================================================
# مزامنة العملاء — معطّلة افتراضيًا (PDPL)
# تُفعَّل فقط لمتاجر نفس التاجر وبموافقة صريحة
# ===================================================
SALLA_ENABLE_CUSTOMER_SYNC=false
